{
  "appId": "com.infinite.app",
  "appName": "Infinite",
  "webDir": "www",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "scheme": "Infinite"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 700,
      "launchAutoHide": true,
      "backgroundColor": "#0a0f16",
      "androidScaleType": "CENTER_CROP",
      "showSpinner": false
    }
  }
}
